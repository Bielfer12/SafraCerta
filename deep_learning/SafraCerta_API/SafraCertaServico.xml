<service>
  <id>SafraCertaAPI</id>
  <name>SafraCerta API</name>
  <description>API de classificação de folhas do SafraCerta.</description>

  <executable>%BASE%\api_modelo\.venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1</arguments>
  <workingdirectory>%BASE%\api_modelo</workingdirectory>

  <env name="GOOGLE_APPLICATION_CREDENTIALS" value="C:\ProgramData\SafraCerta\firebase-api.json"/>
  <env name="GOOGLE_CLOUD_PROJECT" value="safracerta-ee9ce"/>
  <env name="SAFRACERTA_STORAGE_BUCKET" value="safracerta-ee9ce.firebasestorage.app"/>
  <env name="SAFRACERTA_MODELO_LESOES" value="%BASE%\..\modelos\best_lesoes.pt"/>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll"/>
</service>
