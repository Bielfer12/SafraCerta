<service>
  <id>SafraCertaAPI</id>
  <name>SafraCerta API</name>
  <description>API de classificação de folhas do SafraCerta.</description>

  <executable>%BASE%\.venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll"/>
</service>