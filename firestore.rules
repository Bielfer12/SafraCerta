rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function pertenceAoUsuario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ehAdminAtivo() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipoUsuario == 'ADMIN'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.statusConta == 'ATIVO'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('cadastroPendente', false) == false
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('exclusaoPendente', false) == false;
    }

    match /login_por_matricula/{matricula} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    function podeConsultarTalhoes() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipoUsuario in ['ADMIN', 'FUNCIONARIO']
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.statusConta == 'ATIVO'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('cadastroPendente', false) == false
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('exclusaoPendente', false) == false;
    }

    match /talhoes/{talhaoId} {
      allow read: if podeConsultarTalhoes();
      allow write: if false;
    }

    match /analises/{analiseId} {
      allow read: if podeConsultarTalhoes()
        && (ehAdminAtivo() || resource.data.usuarioId == request.auth.uid);
      allow write: if false;
    }

    match /usuarios/{uid} {
      allow get: if pertenceAoUsuario(uid) || ehAdminAtivo();
      allow list: if ehAdminAtivo();
      allow create, delete: if false;
      allow update: if pertenceAoUsuario(uid)
        && request.resource.data.tipoUsuario == resource.data.tipoUsuario
        && request.resource.data.statusConta == resource.data.statusConta
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nomeCompleto',
          'telefone'
        ]);
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
