rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function pertenceAoUsuario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /login_por_matricula/{matricula} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /usuarios/{uid} {
      allow get: if pertenceAoUsuario(uid);
      allow list: if false;
      allow create, delete: if false;
      allow update: if pertenceAoUsuario(uid)
        && request.resource.data.tipoUsuario == resource.data.tipoUsuario
        && request.resource.data.statusConta == resource.data.statusConta
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nomeCompleto',
          'matricula',
          'emailInstitucional',
          'telefone'
        ]);
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
